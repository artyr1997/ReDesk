<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the hardened runtime's leave: Apple Events, and Location (only for the Wi-Fi networks' names in the
	     dashboard). No microphone: the desk listens to nothing (the wave hears the Mac's own sound, a Core Audio
	     tap, asked for by NSAudioCaptureUsageDescription) -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
